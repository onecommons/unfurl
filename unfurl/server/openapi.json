    "/populate_cache": {
      "post": {
        "parameters": [
          {
            "description": "Project ID for authorization and cache key scoping",
            "in": "query",
            "name": "auth_project",
            "required": false,
            "schema": {
              "default": null,
              "nullable": true,
              "type": "string"
            }
          },
          {
            "description": "Branch name; also accepts 'refs/heads/\u2026' and 'refs/tags/\u2026' prefixes",
            "in": "query",
            "name": "branch",
            "required": false,
            "schema": {
              "default": "main",
              "type": "string"
            }
          },
          {
            "description": "File path relative to the project root",
            "in": "query",
            "name": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Latest commit hash for this file",
            "in": "query",
            "name": "latest_commit",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "If truthy (not '0' or 'false'), delete the cache entry instead of populating it",
            "in": "query",
            "name": "removed",
            "required": false,
            "schema": {
              "default": null,
              "nullable": true,
              "type": "string"
            }
          },
          {
            "description": "Repository visibility; private repositories are not cloned automatically",
            "in": "query",
            "name": "visibility",
            "required": false,
            "schema": {
              "default": null,
              "enum": [
                "public",
                "private",
                null
              ],
              "nullable": true,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            },
            "description": "Validation error"
          }
        },
        "summary": "Populate export cache for a project file",
        "tags": [
          "Cache"
        ]
      }
    },
