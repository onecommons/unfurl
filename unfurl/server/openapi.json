{
  "components": {
    "schemas": {
      "ExportResponse": {
        "additionalProperties": true,
        "properties": {
          "ApplicationBlueprint": {
            "additionalProperties": {
              "additionalProperties": {},
              "type": "object"
            },
            "default": null,
            "description": "Map of blueprint name \u2192 ApplicationBlueprint object",
            "nullable": true,
            "type": "object"
          },
          "Deployment": {
            "additionalProperties": {
              "additionalProperties": {},
              "type": "object"
            },
            "default": null,
            "description": "Map of deployment name \u2192 Deployment object (deployment format only)",
            "nullable": true,
            "type": "object"
          },
          "DeploymentEnvironment": {
            "additionalProperties": {},
            "default": null,
            "description": "DeploymentEnvironment object (deployment and environments formats)",
            "nullable": true,
            "type": "object"
          },
          "DeploymentPath": {
            "additionalProperties": {
              "additionalProperties": {},
              "type": "object"
            },
            "default": null,
            "description": "Map of path \u2192 DeploymentPath object (registered ensemble paths)",
            "nullable": true,
            "type": "object"
          },
          "DeploymentTemplate": {
            "additionalProperties": {
              "additionalProperties": {},
              "type": "object"
            },
            "default": null,
            "description": "Map of blueprint name \u2192 DeploymentTemplate object",
            "nullable": true,
            "type": "object"
          },
          "ResourceTemplate": {
            "additionalProperties": {
              "additionalProperties": {},
              "type": "object"
            },
            "default": null,
            "description": "Map of template name \u2192 ResourceTemplate object (TOSCA node template)",
            "nullable": true,
            "type": "object"
          },
          "ResourceType": {
            "additionalProperties": {
              "additionalProperties": {},
              "type": "object"
            },
            "default": null,
            "description": "Map of type name \u2192 ResourceType object (TOSCA node type)",
            "nullable": true,
            "type": "object"
          },
          "deployments": {
            "default": null,
            "description": "Embedded deployment exports (present when include_all_deployments=true)",
            "items": {
              "additionalProperties": {},
              "type": "object"
            },
            "nullable": true,
            "type": "array"
          }
        },
        "type": "object"
      },
      "HTTPError": {
        "properties": {
          "detail": {
            "type": "object"
          },
          "message": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "PatchEnsembleBody": {
        "additionalProperties": true,
        "properties": {
          "blueprint_url": {
            "default": null,
            "description": "Remote blueprint URL to clone when creating an ensemble",
            "nullable": true,
            "type": "string"
          },
          "branch": {
            "default": "main",
            "description": "Target branch",
            "type": "string"
          },
          "cloud_vars_url": {
            "default": null,
            "description": "URL for cloud variables used for vault secret encryption",
            "nullable": true,
            "type": "string"
          },
          "commit_msg": {
            "default": null,
            "description": "Git commit message",
            "nullable": true,
            "type": "string"
          },
          "deployment_blueprint": {
            "default": null,
            "description": "Name of the deployment blueprint to use when creating an ensemble",
            "nullable": true,
            "type": "string"
          },
          "deployment_path": {
            "default": null,
            "description": "Path for the deployment within the project",
            "nullable": true,
            "type": "string"
          },
          "environment": {
            "default": null,
            "description": "Deployment environment name",
            "nullable": true,
            "type": "string"
          },
          "latest_commit": {
            "default": null,
            "description": "Latest known commit hash for optimistic concurrency checks",
            "nullable": true,
            "type": "string"
          },
          "patch": {
            "description": "List of patch operations describing the changes to apply",
            "items": {
              "additionalProperties": {},
              "type": "object"
            },
            "type": "array"
          },
          "private_token": {
            "default": null,
            "description": "Git personal access token or password",
            "nullable": true,
            "type": "string"
          },
          "username": {
            "default": null,
            "description": "Git username for pushing the commit",
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "patch"
        ],
        "type": "object"
      },
      "PatchEnvironmentBody": {
        "additionalProperties": true,
        "properties": {
          "branch": {
            "default": "main",
            "description": "Target branch",
            "type": "string"
          },
          "commit_msg": {
            "default": null,
            "description": "Git commit message",
            "nullable": true,
            "type": "string"
          },
          "latest_commit": {
            "default": null,
            "description": "Latest known commit hash for optimistic concurrency checks",
            "nullable": true,
            "type": "string"
          },
          "patch": {
            "description": "List of patch operations describing the changes to apply",
            "items": {
              "additionalProperties": {},
              "type": "object"
            },
            "type": "array"
          },
          "private_token": {
            "default": null,
            "description": "Git personal access token or password",
            "nullable": true,
            "type": "string"
          },
          "username": {
            "default": null,
            "description": "Git username for pushing the commit",
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "patch"
        ],
        "type": "object"
      },
      "PatchResponse": {
        "additionalProperties": false,
        "properties": {
          "commit": {
            "description": "Commit hash after applying the patch, or null if no changes were committed",
            "nullable": true,
            "type": "string"
          }
        },
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "detail": {
            "properties": {
              "<location>": {
                "properties": {
                  "<field_name>": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                },
                "type": "object"
              }
            },
            "type": "object"
          },
          "message": {
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Unfurl Server API",
    "version": "1.2.1"
  },
