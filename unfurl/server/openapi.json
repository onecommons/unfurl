    "/empty_cache": {
      "post": {
        "parameters": [
          {
            "description": "Must equal the UNFURL_SERVER_ADMIN_PROJECT environment variable",
            "in": "query",
            "name": "auth_project",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Cache key prefix to clear; defaults to the server-configured prefix",
            "in": "query",
            "name": "cache_prefix",
            "required": false,
            "schema": {
              "default": null,
              "nullable": true,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            },
            "description": "Validation error"
          }
        },
        "summary": "Clear all cache entries (admin only)",
        "tags": [
          "Cache"
        ]
      }
    },
    "/export": {
      "get": {
        "description": "Export an ensemble or service template in a JSON format suitable for the frontend. Supports 'deployment', 'blueprint', and 'environments' formats.",
        "parameters": [
          {
            "description": "Project ID for authorization and cache key scoping",
            "in": "query",
            "name": "auth_project",
            "required": false,
            "schema": {
              "default": null,
              "nullable": true,
              "type": "string"
            }
          },
          {
            "description": "Commit hash used to validate the cache entry",
            "in": "query",
            "name": "latest_commit",
            "required": false,
            "schema": {
              "default": null,
              "nullable": true,
              "type": "string"
            }
          },
          {
            "description": "Git branch name",
            "in": "query",
            "name": "branch",
            "required": false,
            "schema": {
              "default": null,
              "nullable": true,
              "type": "string"
            }
          },
          {
            "description": "Pretty-print the JSON response",
            "in": "query",
            "name": "pretty",
            "required": false,
            "schema": {
              "default": false,
              "type": "boolean"
            }
          },
          {
            "description": "Git username (alternative to X-Git-Credentials header)",
            "in": "query",
            "name": "username",
            "required": false,
            "schema": {
              "default": null,
              "nullable": true,
              "type": "string"
            }
          },
          {
            "description": "Repository visibility",
            "in": "query",
            "name": "visibility",
            "required": false,
            "schema": {
              "default": null,
              "enum": [
                "public",
                "private",
                null
              ],
              "nullable": true,
              "type": "string"
            }
          },
          {
            "description": "Export format",
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "default": "deployment",
              "enum": [
                "deployment",
                "blueprint",
                "environments"
              ],
              "type": "string"
            }
          },
          {
            "description": "Path to the deployment within the project",
            "in": "query",
            "name": "deployment_path",
            "required": false,
            "schema": {
              "default": null,
              "nullable": true,
              "type": "string"
            }
          },
          {
            "description": "Environment name (used with 'environments' format)",
            "in": "query",
            "name": "environment",
            "required": false,
            "schema": {
              "default": null,
              "nullable": true,
              "type": "string"
            }
          },
          {
            "description": "Include all deployment exports embedded in the response",
            "in": "query",
            "name": "include_all_deployments",
            "required": false,
            "schema": {
              "default": false,
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExportResponse"
                }
              }
            },
            "description": "GraphQL-style JSON database of TOSCA objects"
          },
          "304": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Not Modified (ETag matched)"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPError"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            },
            "description": "Validation error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPError"
                }
              }
            },
            "description": "Internal error"
          }
        },
        "summary": "Export ensemble as JSON",
        "tags": [
          "Export"
        ]
      }
    },
