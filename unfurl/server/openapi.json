  "paths": {
    "/clear_project_file_cache": {
      "post": {
        "parameters": [
          {
            "description": "Project ID whose cache entries and cloned files will be removed",
            "in": "query",
            "name": "auth_project",
            "required": false,
            "schema": {
              "default": null,
              "nullable": true,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            },
            "description": "Validation error"
          }
        },
        "summary": "Clear cache and cloned files for a project",
        "tags": [
          "Cache"
        ]
      }
    },
