FROM python:3.13-slim

ENV UNFURL_HOME=""

RUN apt-get -qq update && \
    apt-get -qq --no-install-recommends install -y git curl unzip wget expect build-essential tini && \
    apt-get -qq clean -y && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --user-group unfurl

COPY . /unfurl

# The minimal profile has no rustfmt, so the build scripts use the committed
# generated types, which CI checks are current, rather than regenerating them.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal && \
    . "$HOME/.cargo/env" && \
    cargo build --release --manifest-path /unfurl/rust/Cargo.toml --package unfurl-server && \
    cp /unfurl/rust/target/release/unfurl-server /usr/local/bin/unfurl-server && \
    pip install --no-cache-dir /unfurl[server] && \
    rm -rf /unfurl ~/.cargo ~/.rustup

COPY --chmod=0755 docker/aux/server-entrypoint.sh /usr/local/bin/server-entrypoint.sh

USER unfurl:unfurl

EXPOSE 5000

ARG NUM_WORKERS=4
ENV NUM_WORKERS=${NUM_WORKERS}
# -g: signals reach gunicorn and unfurl-server too, not just the script
ENTRYPOINT ["tini", "-g", "--", "/usr/local/bin/server-entrypoint.sh"]
